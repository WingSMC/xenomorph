type Color = [
    "red",
    "green",
    "blue",
];

type User = {
    name: string,
    age: number,
    favoriteColor: Color,
} @Entity @Schema;

type ActionEntry = [?date, Action];
type ActionActions = ActionEntry[] @minlen(1) @maxlen(10);
type Action<T : ActionActions> = {
    actions: ?T,
};



type Admin = & User & ActionHolder;
