type Color = [
    "red",
    "green",
    "blue",
];

type User = {
    name: string,
    age: number,
    favoriteColor: Color,
} @Lombok(Getter, Setter);

type ActionEntry = [?date, Action<User>];
type ActionActions = ActionEntry[] @minlen(1) @maxlen(10);
type Action<T> = {
    actions: ?T,
};



type Admin =
    & User
    & Action<User>;
