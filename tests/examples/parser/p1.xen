import parser/sets/a;
import parser/p2;

type BrightChannel = f64 @min(0.5) @max(1.0);

type BrightColor = {
    r: BrightChannel,
    g: BrightChannel,
    b: BrightChannel,
};

type Action = {};
type ActionEntry = [date, Action];
type AsdActions = ActionEntry[] @minlen(1) @maxlen(10);
type Asd = {
    actions: AsdActions,
};

/**
* This is a comment for the Action type
*/
type Admin = & User & Asd;

type UserId = string @MongoId @SQLPrimary(u64);
type UserName = string @match(/^[A-Z]{3,5}_[0-9]{1,3}$/) @minlen(5) @maxlen(20);
type UserAge = u8 @min(0) @max(150);
type User = {
    // by default it will use string for other targets
    // if it is generating a mongo orm it will use string
    // if it is an SQL ORM it will use u64
    _id: UserId,
    name: UserName,
    age: UserAge ,
    utype: UserType,
    // if tests the languageFilter boolean value implicitly
    // so a validator expression is not needed
    languageFilter: bool ,
    adultContent: bool,
};
// @if(@lt(age, 18),  @eq(adultContent, false))
// @if(languageFilter, @min(age, 16)) @else(@min(age, 12));
