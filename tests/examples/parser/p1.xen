import lexer/1;

type BrightChannel = u8 @min(125) @max(255);

type BrightColor = {
    r: BrightChannel,
    g: BrightChannel,
    b: BrightChannel,
};


type Color = {
    r: u8,
    g: u8,
    b: u8,
};

type Action = {
    command: string,
    user: string,
};
type ActionEntry = [date, Action];
type ValidatedActionEntries = ActionEntry[] @minlen(1) @maxlen(10);
type Asd = {
    actions: ValidatedActionEntries,
};

/**
* This is a comment for the Action type
*/
type Admin =
    & User<string>
    & Asd;

type UserName<T: string> = T @match(/^[A-Z]{3,5}_[0-9]{1,3}$/) @minlen(5) @maxlen(20);
type UserAge = u8 @min(13) @max(150);

type UserType = enum {
    Admin: -1 as i8,
    Guest: 1,
    User: 2,
    Premium: 3,
};

type User <T: string> = {
    // by default it will use string for other targets
    // if it is generating a mongo orm it will use string
    // if it is an SQL ORM it will use u64
    _id: u64,
    name: UserName<T>,
    age: UserAge ,
    utype: UserType,
    // if tests the languageFilter boolean value implicitly
    // so a validator expression is not needed
    languageFilter: bool ,
    adultContent: bool,
    favouriteColor: Color,
    constField: 12325413256 as bigint,
};
// @if(@lt(age, 18),  @eq(adultContent, false))
// @if(languageFilter, @min(age, 16)) @else(@min(age, 12));
