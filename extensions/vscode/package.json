{
    "name": "xenomorph",
    "displayName": "Xenomorph",
    "description": "Xenomorph language support",
    "version": "0.1.2",
    "publisher": "WingSMC",
    "engines": {
        "vscode": "^1.75.0"
    },
    "author": {
        "name": "WingSMC",
        "url": "https://github.com/WingSMC"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/WingSMC/xenomorph.git",
        "directory": "extensions/vscode"
    },
    "categories": [
        "Debuggers",
        "Formatters",
        "Linters",
        "Programming Languages",
        "Snippets",
        "Testing"
    ],
    "activationEvents": [],
    "scripts": {
        "all": "nr build && nr package",
        "build": "cd client && nr build",
        "package": "node ./scripts/package.mjs",
        "publish": "node ./scripts/package.mjs --publish"
    },
    "main": "./client/out/extension",
    "icon": "./icons/logo-white.png",
    "extensionDependencies": [
        "tamasfe.even-better-toml"
    ],
    "contributes": {
        "commands": [
            {
                "command": "xenomorph.parse",
                "title": "Parse Current Document",
                "category": "Xenomorph",
                "icon": "$(checklist)"
            },
            {
                "command": "xenomorph.debug",
                "title": "Debug Current Document (Tokens + AST)",
                "category": "Xenomorph",
                "icon": "$(debug-alt)"
            },
            {
                "command": "xenomorph.showAst",
                "title": "Show AST Visualization",
                "category": "Xenomorph",
                "icon": "$(type-hierarchy)"
            },
            {
                "command": "xenomorph.showModuleGraph",
                "title": "Show Module Graph",
                "category": "Xenomorph",
                "icon": "$(references)"
            },
            {
                "command": "xenomorph.showModuleGraphJson",
                "title": "Show Module Graph JSON",
                "category": "Xenomorph",
                "icon": "$(json)"
            },
            {
                "command": "xenomorph.restartLsp",
                "title": "Restart LSP Server",
                "category": "Xenomorph",
                "icon": "$(refresh)"
            }
        ],
        "languages": [
            {
                "id": "xenomorph",
                "aliases": [
                    "xenomorph"
                ],
                "extensions": [
                    ".xen"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./icons/logo-black.png",
                    "dark": "./icons/logo-white.png"
                }
            }
        ],
        "grammars": [
            {
                "language": "xenomorph",
                "scopeName": "source.xenomorph",
                "path": "./syntaxes/xenomorph.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "xenomorph",
                "path": "./snippets/snippets.json"
            }
        ],
        "configurationDefaults": {
            "[xenomorph]": {
                "editor.semanticHighlighting.enabled": true
            },
            "evenBetterToml.schema.associations": {
                ".*xenomorph\\.toml$": "./.xenomorph/xenomorph.schema.json"
            }
        },
        "configuration": {
            "title": "Xenomorph",
            "properties": {
                "xenomorph.lsp.executable": {
                    "type": "string",
                    "default": "xenomorph_lsp",
                    "scope": "machine-overridable",
                    "description": "LSP executable name or path. The default resolves xenomorph_lsp from PATH. Reload the extension after changing it."
                },
                "xenomorph.parser.executable": {
                    "type": "string",
                    "default": "xeno",
                    "scope": "machine-overridable",
                    "description": "Parser executable name or path. The default resolves xeno from PATH."
                },
                "xenomorph.parser.timeout": {
                    "type": "number",
                    "default": 15000,
                    "minimum": 1000,
                    "scope": "resource",
                    "description": "Maximum time in milliseconds for parse, debug, AST inspection, and module graph commands."
                },
                "xenomorph.codeLens.enabled": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "description": "Show Parse, Debug, and View AST actions above declarations."
                }
            }
        },
        "menus": {
            "editor/title": [
                {
                    "command": "xenomorph.showAst",
                    "when": "editorLangId == xenomorph",
                    "group": "navigation"
                },
                {
                    "command": "xenomorph.showModuleGraph",
                    "when": "editorLangId == xenomorph",
                    "group": "navigation"
                }
            ]
        }
    }
}
