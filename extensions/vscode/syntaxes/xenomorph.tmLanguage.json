{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "xenomorph",
    "patterns": [
        { "include": "#comments" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.xenomorph",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.xenomorph",
                    "begin": "/\\*",
                    "end": "\\*/",
                    "patterns": [
                        {
                            "name": "comment.block.documentation.xenomorph",
                            "match": "^\\s*\\*.*$"
                        }
                    ]
                }
            ]
        }
    },
    "scopeName": "source.xenomorph"
}
