{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "xenomorph",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#import-declarations"
        },
        {
            "include": "#type-declarations"
        },
        {
            "include": "#annotations"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#regex"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#object-definition"
        },
        {
            "include": "#object-properties"
        },
        {
            "include": "#type-references"
        },
        {
            "include": "#punctuation"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.xenomorph",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.xenomorph",
                    "begin": "/\\*",
                    "end": "\\*/",
                    "patterns": [
                        {
                            "name": "comment.block.documentation.xenomorph",
                            "match": "^\\s*\\*.*$"
                        }
                    ]
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.declaration.xenomorph",
                    "match": "\\b(type|set|enum|validator)\\b"
                },
                {
                    "name": "keyword.control.import.xenomorph",
                    "match": "\\bimport\\b"
                },
                {
                    "name": "constant.language.boolean.xenomorph",
                    "match": "\\b(true|false)\\b"
                }
            ]
        },
        "import-declarations": {
            "patterns": [
                {
                    "match": "\\b(import)\\s+([A-Za-z_][A-Za-z0-9_]*(?:/[A-Za-z_][A-Za-z0-9_]*)*)",
                    "captures": {
                        "1": {
                            "name": "keyword.control.import.xenomorph"
                        },
                        "2": {
                            "name": "entity.name.namespace.xenomorph"
                        }
                    }
                }
            ]
        },
        "type-declarations": {
            "patterns": [
                {
                    "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:<|=))",
                    "captures": {
                        "1": {
                            "name": "keyword.control.declaration.xenomorph"
                        },
                        "2": {
                            "name": "entity.name.type.declaration.xenomorph"
                        }
                    }
                }
            ]
        },
        "annotations": {
            "patterns": [
                {
                    "match": "(@)([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "keyword.operator.annotation.xenomorph"
                        },
                        "2": {
                            "name": "entity.name.function.decorator.xenomorph"
                        }
                    }
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.logical.xenomorph",
                    "match": "\\bnot\\b|[&|!?]"
                },
                {
                    "name": "keyword.operator.cast.xenomorph",
                    "match": "\\bas\\b"
                },
                {
                    "name": "keyword.operator.comparison.xenomorph",
                    "match": "!=|[=<>]"
                },
                {
                    "name": "keyword.operator.arithmetic.xenomorph",
                    "match": "-"
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double.xenomorph",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.xenomorph",
                    "match": "\\\\."
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.xenomorph",
                    "match": "(?<![A-Za-z0-9_.])-?[0-9]+\\.[0-9]+\\b"
                },
                {
                    "name": "constant.numeric.integer.xenomorph",
                    "match": "(?<![A-Za-z0-9_.])-?[0-9]+\\b"
                }
            ]
        },
        "regex": {
            "name": "string.regexp.xenomorph",
            "begin": "/(?![\\s*/])",
            "end": "/",
            "patterns": [
                {
                    "name": "constant.character.escape.regexp.xenomorph",
                    "match": "\\\\."
                }
            ]
        },
        "object-definition": {
            "patterns": [
                {
                    "begin": "{",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.block.begin.xenomorph"
                        }
                    },
                    "end": "}",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.block.end.xenomorph"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#comments"
                        },
                        {
                            "include": "#object-properties"
                        },
                        {
                            "include": "#expressions"
                        }
                    ]
                }
            ]
        },
        "object-properties": {
            "patterns": [
                {
                    "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
                    "captures": {
                        "1": {
                            "name": "variable.other.property.xenomorph"
                        },
                        "2": {
                            "name": "punctuation.separator.key-value.xenomorph"
                        }
                    }
                }
            ]
        },
        "type-references": {
            "patterns": [
                {
                    "match": "\\b(TYPE|any|bool|number|integer|i4|i8|i16|i32|i64|i128|u4|u8|u16|u32|u64|u128|f32|f64|bigint|decimal|date|datetime|duration|string|char|uuid|regex|ip|ipv4|ipv6|hostname|email|url|binary|json|xml|yaml|toml|csv|tsv|semver|dict)\\b",
                    "name": "support.type.primitive.xenomorph"
                },
                {
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
                    "name": "support.type.xenomorph"
                }
            ]
        },
        "array-notation": {
            "patterns": [
                {
                    "begin": "\\[",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.array.begin.xenomorph"
                        }
                    },
                    "end": "\\]",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.array.end.xenomorph"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#expressions"
                        }
                    ]
                }
            ]
        },
        "expressions": {
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "include": "#strings"
                },
                {
                    "include": "#numbers"
                },
                {
                    "include": "#keywords"
                },
                {
                    "include": "#annotations"
                },
                {
                    "include": "#operators"
                },
                {
                    "include": "#regex"
                },
                {
                    "include": "#object-definition"
                },
                {
                    "include": "#array-notation"
                },
                {
                    "include": "#type-references"
                },
                {
                    "include": "#punctuation"
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.terminator.statement.xenomorph",
                    "match": ";"
                },
                {
                    "name": "punctuation.separator.delimiter.xenomorph",
                    "match": ","
                },
                {
                    "name": "punctuation.section.group.begin.xenomorph",
                    "match": "\\("
                },
                {
                    "name": "punctuation.section.group.end.xenomorph",
                    "match": "\\)"
                },
                {
                    "name": "punctuation.definition.generic.begin.xenomorph",
                    "match": "<"
                },
                {
                    "name": "punctuation.definition.generic.end.xenomorph",
                    "match": ">"
                }
            ]
        }
    },
    "scopeName": "source.xenomorph"
}
